# ---- Model provider ----
# anthropic (default) | openai | xai | google | qwen | deepseek | mistral | groq | openrouter | ollama | custom
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# For any other provider: its key (or the provider's usual env var, e.g. OPENAI_API_KEY, XAI_API_KEY, GEMINI_API_KEY, DASHSCOPE_API_KEY)
# LLM_API_KEY=...
# LLM_MODEL=gpt-5                        # override the preset's default model
# LLM_BASE_URL=https://my-vllm.example/v1  # only for LLM_PROVIDER=custom or to point at a proxy

# ---- Speech to text (desktop audio path only; the bot path transcribes on the bot) ----
DEEPGRAM_API_KEY=...

# ---- API server ----
PORT=8787
CLOSER_DEV_API_KEY=dev-local-key          # single-tenant dev key; replace with DB-backed keys in prod
COACH_MODEL=claude-opus-5-5              # or claude-sonnet-5-5 for lower latency and cost
COACH_EFFORT=low                         # low | medium | high
SUMMARY_MODEL=claude-opus-5-5
INSIGHT_MODEL=claude-opus-5-5              # structured deal read every few prospect turns
CHAT_MODEL=claude-opus-5-5               # "help me on this call" chat in the web app
JWT_SECRET=change-me-to-a-long-random-string
SECURE_COOKIES=false                     # true in production (web and API on different subdomains)
COACH_WEB_SEARCH=false                   # true lets the coach search the web for out-of-playbook questions (adds latency)
PUBLIC_URL=https://your-tunnel.example   # public HTTPS URL of this API; Recall posts webhooks here
DATABASE_URL=postgres://closer:closer@localhost:5432/closer

# ---- Meeting bot path (optional, phase 2) ----
RECALL_API_KEY=...
RECALL_REGION=us-east-1
RECALL_WEBHOOK_SECRET=...

# ---- Calendar auto-join (Fireflies-style). Either or both. ----
# Microsoft Entra app registration: Calendars.Read, User.Read, offline_access; redirect URI {PUBLIC_URL}/v1/integrations/calendar/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# Google Cloud OAuth client (web): calendar.readonly, userinfo.email; redirect URI {PUBLIC_URL}/v1/integrations/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_URL=http://localhost:3000                # where the browser lands after connecting a calendar

# ---- CRM (optional) ----
SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=...

# ---- Web app (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---- Desktop app ----
VITE_CLOSER_API_URL=ws://localhost:8787/v1/live
VITE_CLOSER_API_KEY=dev-local-key
